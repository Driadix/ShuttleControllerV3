flowchart TD
    ACC["Accepted: экземпляр создан,<br/>владение лифтерным приводом:<br/>root - эксклюзивное, child - делегированное"]

    S1["Проверка консистентности sensing концевиков"]
    Q1{"Противоречивое sensing:<br/>оба концевика активны одновременно?"}
    Q2{"Платформа уже в запрошенной<br/>крайней позиции target?"}

    RAMP["Ramp: ступенчатый разгон<br/>лифтерного привода до полной скорости"]

    subgraph LOOP["Running - цикл хода до целевого концевика"]
        direction TB
        TICK["Итерация цикла: heartbeat-команда приводу,<br/>надзор, наблюдение тока привода (target = up),<br/>обслуживание sensing"]
    end

    Q3{"Целевой концевик сработал?"}
    Q4{"Противоречивое sensing концевиков<br/>во время хода?"}
    Q5{"Время хода превысило<br/>LiftTravelTimeout?"}

    STOP["Stop intent авторизованного источника<br/>(принимается в любой момент)"]
    STP["Stopping: детерминированный безопасный<br/>останов лифтерного привода, освобождение ресурсов"]
    SAF["Safety interruption: precedence надзора.<br/>Точный исход делегирован Safety & Health"]

    FIN["Цель достигнута: управляемый останов привода,<br/>обновление состояния платформы по target:<br/>поднятое состояние и наблюдение перегрузки (target = up),<br/>опущенное состояние и освобождение load (target = down)"]

    OK["Succeeded: платформа в запрошенной крайней позиции"]
    CXL["Cancelled"]
    F_TO["Failed (fault): LiftTravelTimeout"]
    F_INV["Failed (fault): противоречивое sensing концевиков"]
    F_SF["Failed (fault): отказ sensing, питание,<br/>иные сквозные paths надзора"]
    PUB["Terminal outcome опубликован:<br/>typed code, диагностический контекст,<br/>snapshot обновлён, ресурсы освобождены"]

    ACC --> S1 --> Q1
    Q1 -->|да| F_INV
    Q1 -->|нет| Q2
    Q2 -->|да| OK
    Q2 -->|нет| RAMP --> LOOP
    LOOP --> Q3
    Q3 -->|да| FIN --> OK
    Q3 -->|нет| Q4
    Q4 -->|да| F_INV
    Q4 -->|нет| Q5
    Q5 -->|да| F_TO
    Q5 -->|нет| TICK
    STOP --> STP --> CXL
    RAMP -.->|stop в любой момент| STP
    LOOP -.->|stop в любой момент| STP
    RAMP -.->|надзор: детектирован отказ| F_SF
    LOOP -.->|надзор: детектирован отказ| F_SF
    SAF -.->|исход по правилам Safety & Health| PUB
    OK --> PUB
    CXL --> PUB
    F_TO --> PUB
    F_INV --> PUB
    F_SF --> PUB
