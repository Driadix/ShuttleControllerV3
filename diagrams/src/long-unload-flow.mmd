flowchart TD
    ACC["Accepted: экземпляр создан,<br/>эксклюзивное владение приводом движения<br/>и лифтером"]

    PREP["Подготовка цикла: флаг долгой работы,<br/>опускание лифтера, выезд к началу канала,<br/>временная переустановка межпаллетной дистанции,<br/>инверсия при режиме FIFO/LIFO"]

    subgraph CYCLE["Running - цикл выгрузки до «канал пуст»"]
        direction TB
        SUB["Подоперация снятия паллеты:<br/>подъезд к паллете со стороны заднего конца канала,<br/>поиск досок движением назад, заезд под паллету,<br/>подъём лифтера, перехват при потере датчиков,<br/>вывоз к началу канала, ожидание зоны впереди,<br/>пауза доставки; паллета остаётся поднятой"]
        Q1{"Канал пуст:<br/>шаттл у заднего конца канала<br/>после поиска?"}
        WAIT["Ожидание освобождения зоны впереди:<br/>паллета впереди, шаттл далеко от начала канала<br/>(семантика ожиданий - unknown U09)"]
        APPR["Подъезд к началу канала<br/>по ступенчатому профилю скорости"]
        PLACE["Остановка, опускание лифтера -<br/>паллета уложена у начала канала,<br/>отъезд к следующей паллете"]
        SIDE["Побочный эффект завершающей итерации:<br/>предупреждение о препятствии впереди<br/>и запись ошибки из безрезультатного поиска<br/>(change-предложение: различать «паллет больше нет»<br/>и «препятствие»)"]
        SUB --> Q1
        Q1 -->|да| EXIT
        Q1 -->|нет| WAIT --> APPR --> PLACE --> SUB
        SUB -.->|финальная итерация: безрезультатный поиск,<br/>дожим к заднему концу| SIDE
        SIDE -.-> Q1
    end

    EXIT["Завершение цикла: восстановление<br/>межпаллетной дистанции, отключение инверсии,<br/>финальный выезд к началу канала"]

    OK["Succeeded: канал пуст,<br/>шаттл у начала канала"]
    CXL["Cancelled"]
    ER["Ранний возврат при прерывании<br/>в глубине канала: без финального выезда,<br/>без завершающей телеметрии по V1<br/>(change-предложение)"]
    F_TO["Failed (fault): LiftTravelTimeout"]
    F_MV["Failed (fault): MoveNoProgress"]
    F_SF["Failed (fault): отказ sensing, stall,<br/>столкновение, питание"]
    D_PS["Failed (domain-condition): PalletSizeError"]
    D_PN["Failed (domain-condition): PalletNotFound<br/>(нет места впереди)"]
    SAF["Safety interruption: precedence надзора.<br/>Точный исход делегирован Safety & Health"]
    PUB["Terminal outcome опубликован:<br/>typed code, диагностический контекст,<br/>snapshot обновлён, ресурсы освобождены"]

    ACC --> PREP --> CYCLE
    Q1 -->|да| EXIT --> OK
    SUB -.->|локальный исход:<br/>недопустимый размер паллеты| D_PS
    SUB -.->|локальный исход:<br/>нет места впереди| D_PN
    SUB -.->|таймаут хода лифтера| F_TO
    CYCLE -.->|stop в любой момент| CXL
    CYCLE -.->|прерывание в глубине канала| ER
    ER --> CXL
    CYCLE -.->|нет приращения позиции| F_MV
    CYCLE -.->|надзор: детектирован отказ| F_SF
    CYCLE -.->|safety precedence| SAF
    SAF -.->|исход по правилам Safety & Health| PUB
    OK --> PUB
    CXL --> PUB
    F_TO --> PUB
    F_MV --> PUB
    F_SF --> PUB
    D_PS --> PUB
    D_PN --> PUB
