flowchart TD
    ACC["Accepted: экземпляр создан,<br/>эксклюзивное владение приводом движения<br/>и лифтером, маркер полноты канала сброшен"]

    subgraph PH1["Выезд к началу канала и осмотр"]
        direction TB
        S1["Опускание платформы и выезд<br/>к началу канала (движение вперёд)"]
        S2["Осмотр у начала канала:<br/>дистанция, паллетные датчики"]
        S1 --> S2
    end

    Q1{"Паллета видна передними<br/>паллетными датчиками?"}
    S3["Поисковый задний ход в пределах<br/>области поиска от начала канала"]
    Q2{"Паллета обнаружена<br/>или граница области поиска<br/>достигнута?"}

    subgraph WA1["Ожидание первой паллеты (бессрочное)"]
        direction TB
        W11["Предупреждение PalletNotFound (однократно),<br/>отъезд назад на дистанцию ожидания"]
        W12["Проверка присутствия паллеты:<br/>передние датчики или признак появления<br/>паллеты впереди"]
        W13["Стабилизация паллеты<br/>в окне стабилизации"]
        W11 --> W12 --> W13
    end

    subgraph CYCLE["Цикл погрузки (повторяется до завершения)"]
        direction TB
        C1["Загрузка паллеты - подоперация load:<br/>подъезд, заезд под паллету, выдержка под доской,<br/>проверка допустимого размера, подъём платформы,<br/>перехват при потере паллеты"]
        C2["Транспортировка к месту укладки<br/>и укладка паллеты в задней части канала"]
        C1 --> C2
    end

    Q3{"Условие завершения<br/>'канал полон' достигнуто?"}
    Q4{"Шаттл у начала<br/>канала?"}
    S4["Отъезд назад от начала канала<br/>на дистанцию ожидания"]

    subgraph WA2["Ожидание следующей паллеты (бессрочное)"]
        direction TB
        W21["Проверка присутствия паллеты:<br/>передние датчики или признак появления<br/>паллеты впереди"]
        W22["Стабилизация паллеты<br/>в окне стабилизации"]
        W21 --> W22
    end

    RETRY["Предупреждение ObstacleAhead<br/>по таймауту поиска досок без смены статуса:<br/>повтор цикла без эскалации<br/>(change-предложение: счётчик повторов)"]

    STOP["Stop intent авторизованного источника<br/>(принимается в любой момент)"]
    STP["Stopping: детерминированный безопасный<br/>останов всех actuator-ов, освобождение ресурсов"]
    SAF["Safety interruption: precedence надзора.<br/>Точный исход делегирован Safety & Health"]

    OK["Succeeded: ChannelFull - канал полон,<br/>шаттл остаётся у места последней укладки"]
    CXL["Cancelled"]
    F_NP["Failed (fault): NoMotionProgress"]
    F_LT["Failed (fault): LiftTravelTimeout"]
    F_SF["Failed (fault): отказ/freshness sensing,<br/>stall, столкновение, питание"]
    D_PS["Failed (domain-condition): PalletSizeError"]
    D_OA["Failed (domain-condition): ObstacleAhead<br/>(терминирующие варианты)"]
    D_PL["Failed (domain-condition): PalletLossDuringTransfer<br/>при перевозке у конца канала"]
    PUB["Terminal outcome опубликован:<br/>typed code, диагностический контекст,<br/>snapshot обновлён, ресурсы освобождены"]

    ACC --> PH1 --> Q1
    Q1 -->|да| CYCLE
    Q1 -->|нет| S3 --> Q2
    Q2 -->|обнаружена| CYCLE
    Q2 -->|граница области поиска достигнута,<br/>паллета не найдена| WA1
    WA1 -->|паллета появилась и стабилизирована| CYCLE
    CYCLE --> Q3
    Q3 -->|да| OK
    Q3 -->|нет| Q4
    Q4 -->|да| S4 --> WA2 --> CYCLE
    Q4 -->|нет| CYCLE
    CYCLE -.->|таймаут поиска досок| RETRY
    RETRY --> CYCLE
    C1 -->|недопустимый размер паллеты| D_PS
    C1 -->|препятствие: место занято,<br/>сближение с препятствием| D_OA
    C1 -->|потеря паллеты при перевозке,<br/>упор в конец канала| D_PL
    STOP --> STP --> CXL
    PH1 -.->|stop в любой момент| STP
    WA1 -.->|stop в любой момент| STP
    CYCLE -.->|stop в любой момент| STP
    WA2 -.->|stop в любой момент| STP
    PH1 -.->|надзор: детектирован отказ| F_SF
    CYCLE -.->|надзор: детектирован отказ| F_SF
    CYCLE -.->|движение без прогресса в окне| F_NP
    CYCLE -.->|лифтер не достиг концевика в окне| F_LT
    PH1 -.->|safety precedence| SAF
    WA1 -.->|safety precedence| SAF
    CYCLE -.->|safety precedence| SAF
    WA2 -.->|safety precedence| SAF
    SAF -.->|исход по правилам Safety & Health| PUB
    OK --> PUB
    CXL --> PUB
    F_NP --> PUB
    F_LT --> PUB
    F_SF --> PUB
    D_PS --> PUB
    D_OA --> PUB
    D_PL --> PUB
