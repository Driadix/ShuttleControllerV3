flowchart TD
    ACC["Accepted: экземпляр создан,<br/>эксклюзивное владение приводом движения"]

    S1["Опускание платформы,<br/>обнуление счётчика паллет"]
    S2["Проезд в начало канала"]
    Q1{"Паллета под шаттлом<br/>в начальной точке?"}
    ST["Паллета начальной точки<br/>учитывается в результате"]
    Q2{"Пространство впереди пусто:<br/>паллета не наблюдается?"}
    S3["Подъезд к первому паллету<br/>в глубине канала"]
    Q3{"Конец канала достигнут,<br/>паллета не обнаружена?"}

    S4["Старт обратного прохода:<br/>медленное движение назад<br/>по каналу"]

    subgraph PASS["Running - обратный проход по каналу"]
        direction TB
        TICK["Итерация прохода: sensing расстояний<br/>и паллетных датчиков, надзор"]
        Q4{"Доска паллеты:<br/>пара датчиков активна?"}
        BRD["Учёт доски: на открывающей доске группы -<br/>позиция паллеты, на завершающей - ширина;<br/>завершённая группа = паллета"]
        subgraph INNER["Внутренний контур - проезд мимо паллеты<br/>(защита от двойного счёта)"]
            direction TB
            I1["Проход продолжается, пока активен<br/>хотя бы один датчик пары;<br/>учёт досок заблокирован"]
            I2["Регулировка скорости по остатку<br/>до конца канала (квант)"]
            I1 --> I2
            I2 -->|продолжение,<br/>датчик активен| I1
        end
        Q5{"Конец канала:<br/>порог останова достигнут?"}
        Q6{"Тик регулировки скорости<br/>по кванту?"}
        TICK --> Q4
        Q4 -->|да| BRD
        Q4 -->|нет| Q5
        BRD --> INNER
        I1 -->|оба датчика<br/>освободились| Q5
        I2 -->|порог конца канала| EXIT
        Q5 -->|да| EXIT
        Q5 -->|нет| Q6
        Q6 -->|да| I2
        Q6 -->|нет| TICK
    end

    EXIT["Управляемый останов,<br/>завершение прохода"]
    FIN["Итоговый подсчёт: завершённые группы досок<br/>плюс паллета начальной точки;<br/>уточнение длины канала"]
    S5["Возврат в начало канала<br/>(контракт операции)"]

    STOP["Stop intent авторизованного источника<br/>(принимается в любой момент)"]
    STP["Stopping: детерминированный безопасный<br/>останов привода, освобождение ресурсов"]
    SAF["Safety interruption: precedence надзора.<br/>Точный исход делегирован Safety & Health"]

    OK["Succeeded: проход завершён, подсчёт выполнен,<br/>шаттл в начале канала,<br/>счётчик паллет наблюдаем"]
    CXL["Cancelled"]
    F_SF["Failed (fault): LiftStall, LiftFault,<br/>отказ или потеря freshness sensing,<br/>питание ниже порога"]
    D_NP["Failed (domain-condition): NoPallets,<br/>warning level"]
    PUB["Terminal outcome опубликован:<br/>typed code, диагностический контекст,<br/>snapshot обновлён, ресурсы освобождены"]

    ACC --> S1 --> S2 --> Q1
    Q1 -->|да| ST
    Q1 -->|нет| Q2
    ST --> Q2
    Q2 -->|да| S3 --> Q3
    Q3 -->|да| D_NP
    Q3 -->|нет| S4
    Q2 -->|нет| S4
    S4 --> PASS
    EXIT --> FIN --> S5 --> OK
    STOP --> STP --> CXL
    S1 -.->|stop в любой момент| STP
    S2 -.->|stop в любой момент| STP
    S3 -.->|stop в любой момент| STP
    PASS -.->|stop в любой момент| STP
    S5 -.->|stop в любой момент| STP
    S1 -.->|отказ лифтера| F_SF
    PASS -.->|надзор: детектирован отказ| F_SF
    PASS -.->|надзор: safety precedence| SAF
    SAF -.->|исход по правилам Safety & Health| PUB
    OK --> PUB
    CXL --> PUB
    F_SF --> PUB
    D_NP --> PUB
