flowchart TD
    ACC["Accepted: экземпляр создан,<br/>эксклюзивное владение приводом движения и лифтером"]

    S0["Подготовка: опускание платформы,<br/>подвод к началу канала"]
    S1["Вход подоперации выгрузки:<br/>при режиме FIFO/LIFO - инверсия направления,<br/>работа в инвертированной системе отсчёта;<br/>платформа опущена"]

    Q1{"Направление к глубокому концу канала<br/>свободно?"}
    APP["Подход: движение к паллете<br/>до зоны паллеты или конца канала"]

    subgraph SEARCH["Поиск досок - движение назад"]
        direction TB
        T1["Цикл поиска: пересчёт скорости<br/>по задней дистанции"]
        Q_OA{"Таймаут поиска<br/>или конец канала?"}
    end

    Q2{"Первая доска обнаружена<br/>задней парой датчиков?"}
    S2["Фиксация позиции паллеты,<br/>фиксированный заезд под паллету<br/>на профильную дистанцию"]

    subgraph BBD["Доезд под заднюю доску (board-delay)"]
        direction TB
        T2["Шаги ожидания с проверками,<br/>оценка длины паллеты;<br/>ранний выход при передней паре"]
    end

    Q3{"Паллета длиннее платформы<br/>(задняя доска не увидена)?"}
    Q5{"Место впереди свободно?"}
    LIFT["Подъём паллеты;<br/>фиксация позиции захвата<br/>при близкой паллете сзади"]
    Q6{"Передняя пара сработала<br/>после подъёма?"}

    subgraph RECAP["Перехват паллеты (recapture)"]
        direction TB
        T3["Движение вперёд на профильную дистанцию,<br/>опускание платформы,<br/>откат назад до передней пары;<br/>конец канала - пересчёт длины канала"]
    end

    Q7{"Конец канала при откате?"}

    subgraph DEL["Доставка к началу канала"]
        direction TB
        T4["Подъезд к началу канала"]
        Q8{"Шаттл уже у начала канала?"}
        W1["Ожидание освобождения места впереди<br/>(без таймаута)"]
        W2["Пауза перед финальным подъездом"]
        T5["Подъезд вплотную к началу канала<br/>с защитным остановом при препятствии"]
    end

    PLACE["Размещение: фиксация позиции у начала канала,<br/>опускание паллеты, bookkeeping,<br/>восстановление инверсии"]
    FIN["Финальный подъезд к началу канала"]
    OK["Succeeded: паллета размещена<br/>у начала канала, платформа опущена"]

    STOP["Stop intent авторизованного источника<br/>(принимается в любой момент)"]
    STP["Stopping: детерминированный безопасный останов<br/>привода движения и лифтера,<br/>освобождение ресурсов"]
    SAF["Safety interruption: precedence надзора.<br/>Точный исход делегирован Safety & Health"]

    F_MT["Failed (fault): MoveTimeout, LifterTimeout,<br/>MotorStall, PositionReadFault,<br/>отказ ToF, stall, столкновение, питание"]
    D_PS["Failed (domain-condition): PalletSizeError,<br/>warning level"]
    D_OA["Failed (domain-condition): ObstacleAhead,<br/>warning level"]
    D_NS["Failed (domain-condition): NoSpaceAhead,<br/>warning level"]
    D_CE["Failed (domain-condition): ChannelEndReached"]
    CXL["Cancelled"]
    PUB["Terminal outcome опубликован:<br/>typed code, диагностический контекст,<br/>snapshot обновлён, ресурсы освобождены"]

    ACC --> S0 --> S1 --> Q1
    Q1 -->|да| APP
    Q1 -->|нет| SEARCH
    APP --> SEARCH
    SEARCH --> Q2
    Q2 -->|нет| T1 --> Q_OA
    Q_OA -->|нет| SEARCH
    Q_OA -->|да| D_OA
    Q2 -->|да| S2 --> BBD
    BBD --> Q3
    Q3 -->|да| D_PS
    Q3 -->|нет| Q5
    Q5 -->|нет| D_NS
    Q5 -->|да| LIFT --> Q6
    Q6 -->|нет| RECAP
    Q6 -->|да| DEL
    RECAP --> Q7
    Q7 -->|да| D_CE
    Q7 -->|нет| DEL
    DEL --> T4 --> Q8
    Q8 -->|да| PLACE
    Q8 -->|нет| W1 --> W2 --> T5 --> PLACE
    PLACE --> FIN --> OK
    STOP --> STP --> CXL
    SEARCH -.->|stop в любой момент| STP
    BBD -.->|stop в любой момент| STP
    RECAP -.->|stop в любой момент| STP
    DEL -.->|stop в любой момент| STP
    SEARCH -.->|надзор: детектирован отказ| F_MT
    BBD -.->|надзор: детектирован отказ| F_MT
    RECAP -.->|надзор: детектирован отказ| F_MT
    DEL -.->|надзор: детектирован отказ| F_MT
    SEARCH -.->|safety precedence| SAF
    BBD -.->|safety precedence| SAF
    RECAP -.->|safety precedence| SAF
    DEL -.->|safety precedence| SAF
    SAF -.->|исход по правилам Safety & Health| PUB
    OK --> PUB
    CXL --> PUB
    F_MT --> PUB
    D_PS --> PUB
    D_OA --> PUB
    D_NS --> PUB
    D_CE --> PUB
