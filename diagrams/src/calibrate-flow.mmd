flowchart TD
    ACC["Accepted: экземпляр создан,<br/>эксклюзивное владение приводом движения"]

    subgraph PHASE_F["Фаза направления вперёд"]
        direction TB
        F1["Сброс инверсии направления;<br/>разгонный проезд назад<br/>(примитив проезда на дистанцию)"]
        QF1{"Остаток до заднего конца канала<br/>достаточен для разгонного проезда?"}
        F2["Свежее чтение угла энкодера;<br/>нулевой переход вперёд:<br/>движение на калибровочной скорости<br/>до перехода угла через ноль"]
        QF2{"Нулевой переход достигнут?"}
        F3["Захват сегментов вперёд:<br/>окна захвата вокруг границ сегментов,<br/>время между соседними переходами"]
        QF3{"Таблица направления вперёд<br/>заполнена?"}
        F4["Постобработка: нормализация сегментов,<br/>запись в буфер сохраняемой конфигурации<br/>(без записи во flash)"]
    end

    subgraph PHASE_R["Фаза направления назад"]
        direction TB
        R1["Сброс инверсии направления;<br/>проезд вперёд до конца канала<br/>(примитив проезда вперёд)"]
        R2["Свежее чтение угла энкодера;<br/>нулевой переход назад:<br/>движение на калибровочной скорости<br/>до перехода угла через ноль"]
        QR2{"Нулевой переход достигнут?"}
        R3["Захват сегментов назад:<br/>окна захвата вокруг границ сегментов,<br/>время между соседними переходами"]
        QR3{"Таблица направления назад<br/>заполнена?"}
        R4["Постобработка: нормализация сегментов,<br/>запись в буфер сохраняемой конфигурации<br/>(без записи во flash)"]
    end

    QFIN{"Stop intent<br/>до финального проезда?"}
    FIN["Финальный проезд вперёд<br/>до конца канала"]

    STOP["Stop intent авторизованного источника<br/>(принимается в любой момент)"]
    STP["Stopping: детерминированный безопасный<br/>останов привода, освобождение ресурсов"]
    SAF["Safety interruption: precedence надзора.<br/>Точный исход делегирован Safety & Health"]

    F_TO["Failed (fault): CalibrationTimeout -<br/>лимит времени фазы нулевого перехода<br/>или фазы захвата сегментов"]
    F_NP["Failed (fault): NoMotionProgress -<br/>нет прогресса в разгонном проезде<br/>в окне ReverseRunNoProgressWindow"]
    F_ENC["Failed (fault): EncoderReadFault -<br/>отказ свежего чтения угла энкодера"]
    F_SF["Failed (fault): отказ/freshness sensing,<br/>stall, столкновение, питание"]

    OK["Succeeded: таблицы обоих направлений<br/>пересчитаны и записаны в буфер<br/>сохраняемой конфигурации;<br/>шаттл у конца канала.<br/>Персистентность - отдельной командой"]
    CXL["Cancelled"]
    PUB["Terminal outcome опубликован:<br/>typed code, диагностический контекст,<br/>snapshot обновлён, ресурсы освобождены"]

    ACC --> PHASE_F
    F1 --> QF1
    QF1 -->|нет: проезд пропущен,<br/>предупреждение| F2
    QF1 -->|да| F2
    F2 --> QF2
    QF2 -->|нет: продолжить<br/>движение| F2
    QF2 -->|да| F3
    F3 --> QF3
    QF3 -->|нет: продолжить<br/>захват| F3
    QF3 -->|да| F4
    F4 --> PHASE_R
    R1 --> R2 --> QR2
    QR2 -->|нет: продолжить<br/>движение| R2
    QR2 -->|да| R3
    R3 --> QR3
    QR3 -->|нет: продолжить<br/>захват| R3
    QR3 -->|да| R4
    R4 --> QFIN
    QFIN -->|нет| FIN --> OK
    QFIN -->|да| STP

    STOP --> STP --> CXL
    F2 -.->|лимит времени фазы ZeroSeekTimeout| F_TO
    F3 -.->|лимит времени фазы SamplingTimeout| F_TO
    R2 -.->|лимит времени фазы ZeroSeekTimeout| F_TO
    R3 -.->|лимит времени фазы SamplingTimeout| F_TO
    F1 -.->|нет прогресса в окне<br/>ReverseRunNoProgressWindow| F_NP
    F2 -.->|отказ чтения угла| F_ENC
    F3 -.->|отказ чтения угла| F_ENC
    R2 -.->|отказ чтения угла| F_ENC
    R3 -.->|отказ чтения угла| F_ENC
    PHASE_F -.->|stop в любой момент| STP
    PHASE_R -.->|stop в любой момент| STP
    PHASE_F -.->|надзор: детектирован отказ| F_SF
    PHASE_R -.->|надзор: детектирован отказ| F_SF
    PHASE_F -.->|safety precedence| SAF
    PHASE_R -.->|safety precedence| SAF
    SAF -.->|исход по правилам Safety & Health| PUB
    OK --> PUB
    CXL --> PUB
    F_TO --> PUB
    F_NP --> PUB
    F_ENC --> PUB
    F_SF --> PUB
