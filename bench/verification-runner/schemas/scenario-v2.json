{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scenario-v2.json",
  "title": "Verification runner scenario v2",
  "description": "Additive v2 of the scenario contract (ticket #63, docs/sensing-slice-design-v3.md section 5): RAM read-back observation for Phase-1 firmware (UART silent, observability is #72). v1 fields are unchanged; `capture` becomes optional when `readback` is present. The runner stays generic - rule semantics live in the scenario.",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    { "required": ["capture"] },
    { "required": ["readback"] }
  ],
  "required": ["schemaVersion", "id", "title", "type", "phase", "identity"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "type": { "enum": ["behavior", "flash-verify"] },
    "phase": { "enum": ["L4", "L5"] },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["board"],
      "properties": {
        "board": {
          "type": "object",
          "additionalProperties": false,
          "required": ["part", "uid"],
          "properties": {
            "part": { "type": "string", "minLength": 1 },
            "uid": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$" }
          }
        }
      }
    },
    "flash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": { "type": "boolean" },
        "env": { "type": "string", "minLength": 1 }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "baud", "parity", "durationS", "maxBytes"],
      "properties": {
        "port": { "type": "string", "minLength": 1 },
        "baud": { "type": "integer", "exclusiveMinimum": 0 },
        "parity": { "enum": ["N", "E", "O"] },
        "durationS": { "type": "number", "exclusiveMinimum": 0 },
        "maxBytes": { "type": "integer", "exclusiveMinimum": 0 }
      }
    },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["addr", "words", "windowS", "rules"],
      "properties": {
        "addr": { "type": "integer", "exclusiveMinimum": 0 },
        "words": { "type": "integer", "exclusiveMinimum": 0 },
        "windowS": { "type": "number", "exclusiveMinimum": 0 },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "offset", "kind"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "offset": { "type": "integer", "minimum": 0 },
              "kind": { "enum": ["delta", "eq"] },
              "minDelta": { "type": "integer", "minimum": 0 },
              "expect": { "type": "integer" },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minFrames", "maxCrcBadRatio", "requirePatterns", "forbidPatterns"],
      "properties": {
        "minFrames": { "type": "integer", "minimum": 0 },
        "maxCrcBadRatio": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "requirePatterns": { "type": "array", "items": { "type": "string" } },
        "forbidPatterns": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
